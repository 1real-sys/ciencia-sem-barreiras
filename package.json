{
  "name": "ciencia-sem-barreiras",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc -p worker/tsconfig.json",
    "lint": "eslint src shared worker/src tests",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.toml",
    "demo": "node scripts/demo-api.mjs",
    "config": "node scripts/config.mjs",
    "worker:smoke": "node scripts/worker-smoke.mjs",
    "cloud:smoke": "node scripts/cloud-smoke.mjs",
    "security:cloud": "node scripts/security-cloud.mjs"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@supabase/supabase-js": "^2.99.1",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.11.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.3",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.0.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.69.0"
  },
  "type": "module"
}
