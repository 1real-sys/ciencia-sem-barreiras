{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "../shared/**/*.ts"
  ]
}